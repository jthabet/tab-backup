{
  "name": "tab-backup",
  "description": "Tab manager extension",
  "version": "1.0.0",
  "license": "Mozilla Public License 2.0",
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@webpack-cli/generators": "^3.0.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "web-ext": "^10.6.0",
    "web-ext-plugin": "^2.13.0",
    "web-ext-types": "^3.2.1",
    "webpack": "^5.111.0",
    "webpack-bundle-analyzer": "^5.3.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "lint": "web-ext lint --source-dir ./src",
    "start": "webpack -w --env launchFirefox=false",
    "start:firefox": "webpack -w",
    "build": "webpack --mode production",
    "sign-extension": "web-ext sign",
    "build-extension": "web-ext build -s ./dist"
  },
  "webExt": {
    "sourceDir": "src",
    "run": {
      "firefox": "/Applications/Firefox Developer Edition.app/Contents/MacOS/firefox",
      "startUrl": [
        "go.dev",
        "github.com"
      ],
      "devtools": false
    },
    "build": {
      "overwriteDest": true
    }
  }
}
