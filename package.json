  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@webpack-cli/generators": "^3.0.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "web-ext": "^10.8.0",
    "web-ext-plugin": "^2.13.0",
    "web-ext-types": "^3.2.1",
    "webpack": "^5.111.0",
    "webpack-bundle-analyzer": "^5.3.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack -w --env launchFirefox=false",
    "dev": "webpack -w",
    "lint": "pnpm build && web-ext lint",
    "build-extension": "web-ext build",
    "sign-extension": "make sign-extension"
  },
  "webExt": {
    "sourceDir": "dist",
    "run": {
      "firefox": "deved",
      "startUrl": [
        "go.dev",
        "github.com"
